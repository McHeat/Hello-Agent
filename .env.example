# ============================================================
# 复制本文件为 .env，填入你自己的 key（.env 已被 .gitignore 忽略）
#   cp .env.example .env
# ============================================================

# 选一个提供商：anthropic 或 openai（默认 anthropic）
LLM_PROVIDER=anthropic

# 可选：指定具体模型名（不填则用各提供商的默认模型）
#   Anthropic 默认：claude-opus-5-5
#   OpenAI  默认：gpt-4o
# LLM_MODEL=claude-sonnet-5-5

# Anthropic API key（https://console.anthropic.com/ 获取）
ANTHROPIC_API_KEY=

# OpenAI API key（https://platform.openai.com/api-keys 获取）
OPENAI_API_KEY=
