# ============================================================
# 复制本文件为 .env，填入你自己的配置（.env 已被 .gitignore 忽略）
#   cp .env.example .env
# ============================================================

# ---------- 基础配置 ----------
# 提供商：anthropic 或 openai（默认 anthropic）
LLM_PROVIDER=anthropic

# 可选：指定具体模型名（不填则用各提供商的默认模型）
#   Anthropic 默认：claude-opus-5-5
#   OpenAI  默认：gpt-4o
# LLM_MODEL=claude-sonnet-5-5

# 官方渠道的 API key（二选一，按 LLM_PROVIDER 填写）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- 接入「其他大模型」用（可选）----------
# 大多数第三方/本地大模型提供 OpenAI 兼容接口，只需三样：
#   LLM_PROVIDER=openai
#   LLM_MODEL=<对方模型名>
#   LLM_BASE_URL=<对方接口地址>
#   LLM_API_KEY=<对方 key>
# 下面几个常见示例，取消注释即可用（同时把 LLM_PROVIDER 改成 openai）。

# --- 示例 1：DeepSeek ---
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的deepseek-key

# --- 示例 2：通义千问（DashScope 兼容模式）---
# LLM_PROVIDER=openai
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-你的dashscope-key

# --- 示例 3：Ollama 本地模型（无需真实 key，随便填一个非空值）---
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# --- 示例 4：vLLM / 自部署 OpenAI 兼容服务 ---
# LLM_PROVIDER=openai
# LLM_MODEL=你的模型名
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=EMPTY

# 通用说明：
#   LLM_BASE_URL —— 自定义接口地址；不填则用 provider 官方地址。
#   LLM_API_KEY  —— 自定义 key；不填则回退到上面的 ANTHROPIC_API_KEY / OPENAI_API_KEY。
#   若第三方服务是 Anthropic 兼容接口（少见），则 LLM_PROVIDER=anthropic 时
#   LLM_BASE_URL / LLM_API_KEY 同样生效（映射到 anthropic_api_url / anthropic_api_key）。

   # ---------- embeddings（RAG 向量化）用（可选）----------
# huggingface：本地向量化（langchain_community），需 pip install sentence-transformers，无需 API key
# fake       ：零依赖假向量，仅用于开发 / 测试跑通流程
EMBEDDINGS_PROVIDER=huggingface
# huggingface 时的模型名（默认 sentence-transformers/all-MiniLM-L6-v2，可留空）
# EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
